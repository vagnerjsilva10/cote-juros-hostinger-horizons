{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate --schema=prisma/schema.prisma",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:pull": "prisma db pull --schema=prisma/schema.prisma",
    "import:reactivation": "node src/jobs/importLeadsFromSheets.js",
    "retry:reactivation": "node src/jobs/retryPendingDeliveries.js",
    "sync:reactivation:kpis": "node src/jobs/syncReactivationKpis.js",
    "setup:reactivation:sheets": "node scripts/setupReactivationSheets.js",
    "prepare:reactivation:queue": "node scripts/prepareReactivationQueue.js",
    "send:reactivation:emails": "node src/jobs/sendReactivationEmails.js",
    "process:responses": "node src/jobs/processResponses.js",
    "qualify:route": "node src/jobs/qualifyAndRoute.js",
    "follow:up": "node src/jobs/followUp.js",
    "seed:public-catalog": "node scripts/seedPublicCatalog.js",
    "add:test:leads": "node scripts/addTestLeads.js",
    "jobs:start": "node src/jobs/scheduler.js",
    "editorial:ensure": "node src/jobs/runEditorialPipeline.js --ensure=true",
    "editorial:run": "node src/jobs/runEditorialPipeline.js --limit=1 --trigger=manual",
    "editorial:jobs:start": "node src/jobs/editorialScheduler.js",
    "distribution:run": "node src/jobs/runContentDistribution.js --limit=5 --trigger=manual",
    "blog-images:run": "node src/jobs/runBlogImageAutomation.js --limit=1 --trigger=manual",
    "blog-images:backfill": "node src/jobs/backfillBlogImages.js --limit=3",
    "blog-images:jobs:start": "node src/jobs/blogImageScheduler.js",
    "blog-images:validate": "node scripts/validateBlogImagePipeline.js",
    "meta:fix": "node scripts/fixArticleMetaDescriptions.js",
    "seo:growth": "node src/jobs/runSeoGrowth.js"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "@sendgrid/eventwebhook": "^8.0.0",
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.15.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "node-cron": "^4.2.1",
    "prisma": "^6.19.3",
    "zod": "^3.24.1"
  }
}
