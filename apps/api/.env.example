ADMITAD_API_BASE_URL="https://api.admitad.com"
ADMITAD_OAUTH_BASE_URL="https://api.admitad.com"
ADMITAD_CLICKREF_PARAM="subid"
ADMITAD_DEFAULT_WEBSITE=""

# Editorial automation
SITE_BASE_URL="https://www.cotejuros.com.br"
OPENAI_API_KEY=""
OPENAI_EDITORIAL_MODEL="gpt-5"
OPENAI_IMAGE_MODEL="gpt-image-1"
GEMINI_API_KEY=""
GEMINI_EDITORIAL_MODEL="gemini-2.5-pro"
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
GEMINI_IMAGE_SELECTOR_MODEL="gemini-2.5-flash"
EDITORIAL_CRON_MORNING="15 8 * * *"
EDITORIAL_CRON_AFTERNOON="15 14 * * *"
EDITORIAL_CRON_EVENING="15 20 * * *"
