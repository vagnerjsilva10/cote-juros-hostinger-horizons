# API
PORT=4100
CORS_ORIGIN=http://localhost:3000

# Prisma + Supabase Postgres
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Juros Baixos integration
JUROS_BAIXOS_BASE_URL=""
JUROS_BAIXOS_API_KEY=""
JUROS_BAIXOS_CLIENT_ID=""
JUROS_BAIXOS_CLIENT_SECRET=""
JUROS_BAIXOS_WEBHOOK_SECRET=""
JUROS_BAIXOS_TIMEOUT_MS="10000"
JUROS_BAIXOS_RETRY_COUNT="1"

# Optional adapter overrides for Juros Baixos official contract
JUROS_BAIXOS_PARTNER_AUTH_PATH="/oauth/token"
JUROS_BAIXOS_USER_CREATE_PATH="/v1/users"
JUROS_BAIXOS_USER_AUTH_PATH="/v1/users/authenticate"
JUROS_BAIXOS_SIMULATION_CREATE_PATH="/v1/credit/simulations"
JUROS_BAIXOS_SIMULATION_OFFERS_PATH="/v1/credit/simulations/:simulationId/offers"

# Awin affiliates
AWIN_API_TOKEN=""
AWIN_PUBLISHER_ID=""
AWIN_API_BASE_URL="https://api.awin.com"
AWIN_CLICKREF_PARAM="clickref"

# Admitad affiliates
ADMITAD_ACCESS_TOKEN=""
ADMITAD_CLIENT_ID=""
ADMITAD_CLIENT_SECRET=""
ADMITAD_SCOPE="advcampaigns"
ADMITAD_API_BASE_URL="https://api.admitad.com"
ADMITAD_OAUTH_BASE_URL="https://api.admitad.com"
ADMITAD_CLICKREF_PARAM="subid"
ADMITAD_DEFAULT_WEBSITE=""
