generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductType {
  loan
  credit_card
  financing
}

enum CategoryType {
  blog
  product
}

enum RecordStatus {
  draft
  published
  archived
  active
  inactive
}

enum AffiliateNetworkCode {
  awin
  admitad
}

enum ReactivationLeadStatus {
  imported
  visited
  consented
  qualified
  routed
  pending_delivery
  delivery_retrying
  delivery_failed
  delivery_success
  rejected
  expired
  revoked
  suppressed
}

enum ReactivationPartnerMode {
  webhook
  redirect
  email
  whatsapp
}

enum LgpdEventType {
  lead_imported
  link_generated
  token_regenerated
  token_revoked
  page_viewed
  consent_granted
  consent_refused
  consent_revoked
  opt_out_registered
  form_submitted
  duplicate_submit_ignored
  lead_scored
  partner_selected
  partner_routed
  partner_route_failed
  delivery_retry_scheduled
  suppression_checked
  notification_sent
  token_expired
  data_exported
}

enum ReactivationSuppressionScope {
  unsubscribe_email
  unsubscribe_whatsapp
  dnc_global
  revoked_consent
}

enum EmailCampaignStatus {
  draft
  active
  paused
  completed
  archived
}

enum EmailTemplateStatus {
  draft
  active
  inactive
  archived
}

enum EmailMessageStatus {
  queued
  sending
  sent
  delivered
  opened
  clicked
  bounced
  dropped
  spam_reported
  unsubscribed
  failed
  suppressed
  cancelled
}

enum EmailEventType {
  processed
  delivered
  open
  click
  bounce
  dropped
  deferred
  spamreport
  unsubscribe
  group_unsubscribe
  group_resubscribe
  sent
  failed
  suppressed
  manual_resend
}

enum AutomationFlowStatus {
  draft
  active
  paused
  archived
}

enum AutomationNodeType {
  trigger_lead_entry
  eligibility_filter
  delay
  send_email
  condition
  behavior_split
  wait_event
  mark_status
  add_suppression
  end_flow
  webhook_event
  route_partner
  update_lead_field
}

enum AutomationExecutionStatus {
  active
  waiting
  paused
  completed
  failed
  cancelled
}

enum AutomationStepStatus {
  pending
  running
  waiting
  completed
  failed
  skipped
}

enum AdminAuditAction {
  campaign_created
  campaign_updated
  campaign_paused
  campaign_activated
  campaign_archived
  campaign_duplicated
  template_created
  template_updated
  template_published
  flow_created
  flow_updated
  flow_published
  flow_paused
  flow_activated
  lead_email_resent
  lead_flow_moved
  lead_paused
  lead_suppressed
  config_updated
  webhook_received
}

model Bank {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  website   String?
  status    RecordStatus @default(active)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offers Offer[]

  @@index([name])
  @@map("banks")
}

model Category {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  type      CategoryType
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  products FinancialProduct[]
  articles Article[]

  @@index([type])
  @@map("categories")
}

model FinancialProduct {
  id          String      @id @default(cuid())
  type        ProductType
  name        String
  description String?
  categoryId  String?     @map("category_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  offers   Offer[]

  @@index([type])
  @@index([categoryId])
  @@map("financial_products")
}

model Offer {
  id                 String       @id @default(cuid())
  bankId             String       @map("bank_id")
  productId          String       @map("product_id")
  interestRate       Decimal?     @db.Decimal(10, 4) @map("interest_rate")
  cet                Decimal?     @db.Decimal(10, 4)
  minAmount          Decimal?     @db.Decimal(14, 2) @map("min_amount")
  maxAmount          Decimal?     @db.Decimal(14, 2) @map("max_amount")
  minTerm            Int?         @map("min_term")
  maxTerm            Int?         @map("max_term")
  scoreRequirement   String?      @map("score_requirement")
  redirectUrl        String       @map("redirect_url")
  partnerTrackingUrl String?      @map("partner_tracking_url")
  isFeatured         Boolean      @default(false) @map("is_featured")
  status             RecordStatus @default(active)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  bank     Bank             @relation(fields: [bankId], references: [id], onDelete: Cascade)
  product  FinancialProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  clicks   ClickEvent[]
  redirects PartnerRedirect[]

  @@index([bankId])
  @@index([productId])
  @@index([status, isFeatured])
  @@map("offers")
}

model Article {
  id             String       @id @default(cuid())
  slug           String       @unique
  title          String
  content        String
  excerpt        String?
  categoryId     String?      @map("category_id")
  author         String?
  seoTitle       String?      @map("seo_title")
  seoDescription String?      @map("seo_description")
  publishedAt    DateTime?    @map("published_at")
  status         RecordStatus @default(draft)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("articles")
}

model SimulationLead {
  id               String      @id @default(cuid())
  productType      ProductType @map("product_type")
  requestedAmount  Decimal?    @db.Decimal(14, 2) @map("requested_amount")
  income           Decimal?    @db.Decimal(14, 2)
  scoreRange       String?     @map("score_range")
  employmentStatus String?     @map("employment_status")
  hasRestriction   Boolean?    @map("has_restriction")
  fullName         String?     @map("full_name")
  phone            String?
  profile          String?
  partnerId        String?     @map("partner_id")
  partnerName      String?     @map("partner_name")
  deliveryMode     String?     @map("delivery_mode")
  redirectUrl      String?     @map("redirect_url")
  status           String      @default("new")
  utmSource        String?     @map("utm_source")
  utmMedium        String?     @map("utm_medium")
  utmCampaign      String?     @map("utm_campaign")
  originPage       String?     @map("origin_page")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  appIntegrationEvents AppIntegrationEvent[]

  @@index([productType])
  @@index([originPage])
  @@index([profile])
  @@index([partnerId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("simulation_leads")
}

model CreditLead {
  id               String      @id @default(cuid())
  fullName         String      @map("full_name")
  cpf              String
  email            String?
  phone            String?
  birthDate        DateTime?   @map("birth_date")
  mothersName      String?     @map("mothers_name")
  gender           String?
  maritalStatus    String?     @map("marital_status")
  educationalLevel String?     @map("educational_level")
  birthCity        String?     @map("birth_city")
  birthState       String?     @map("birth_state")
  address          String?
  addressNumber    String?     @map("address_number")
  district         String?
  city             String?
  state            String?
  zipCode          String?     @map("zip_code")
  requestedAmount  Decimal?    @db.Decimal(14, 2) @map("requested_amount")
  income           Decimal?    @db.Decimal(14, 2)
  scoreRange       String?     @map("score_range")
  employmentStatus String?     @map("employment_status")
  hasRestriction   Boolean?    @map("has_restriction")
  productType      ProductType @map("product_type")
  sourcePage       String?     @map("source_page")
  utmSource        String?     @map("utm_source")
  utmMedium        String?     @map("utm_medium")
  utmCampaign      String?     @map("utm_campaign")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  providerSessions CreditProviderSession[]
  simulations      CreditSimulation[]

  @@index([cpf])
  @@index([productType, createdAt])
  @@index([sourcePage, createdAt])
  @@map("credit_leads")
}

model CreditProviderSession {
  id                String    @id @default(cuid())
  leadId            String    @map("lead_id")
  provider          String    @default("juros_baixos")
  externalUserId    String?   @map("external_user_id")
  externalSessionId String?   @map("external_session_id")
  externalJwt       String?   @db.Text @map("external_jwt")
  tokenExpiresAt    DateTime? @map("token_expires_at")
  status            String    @default("pending")
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  lead        CreditLead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  simulations CreditSimulation[]

  @@index([leadId, provider])
  @@index([status, updatedAt])
  @@unique([provider, externalUserId])
  @@unique([provider, externalSessionId])
  @@map("credit_provider_sessions")
}

model CreditSimulation {
  id                   String      @id @default(cuid())
  leadId               String      @map("lead_id")
  providerSessionId    String?     @map("provider_session_id")
  provider             String      @default("juros_baixos")
  externalSimulationId String?     @map("external_simulation_id")
  requestedAmount      Decimal?    @db.Decimal(14, 2) @map("requested_amount")
  installments         Int?
  productType          ProductType @map("product_type")
  status               String      @default("pending")
  rawRequest           Json?       @map("raw_request")
  rawResponse          Json?       @map("raw_response")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  lead            CreditLead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  providerSession CreditProviderSession? @relation(fields: [providerSessionId], references: [id], onDelete: SetNull)
  offers          CreditOfferSnapshot[]
  conversions     CreditConversion[]
  clicks          CreditOfferClick[]

  @@index([leadId, createdAt])
  @@index([providerSessionId, createdAt])
  @@index([provider, status, createdAt])
  @@unique([provider, externalSimulationId])
  @@map("credit_simulations")
}

model CreditOfferSnapshot {
  id                String    @id @default(cuid())
  simulationId      String    @map("simulation_id")
  provider          String    @default("juros_baixos")
  externalOfferId   String?   @map("external_offer_id")
  bankName          String    @map("bank_name")
  productName       String    @map("product_name")
  monthlyRate       Decimal?  @db.Decimal(10, 4) @map("monthly_rate")
  cet               Decimal?  @db.Decimal(10, 4)
  installmentAmount Decimal?  @db.Decimal(14, 2) @map("installment_amount")
  totalAmount       Decimal?  @db.Decimal(14, 2) @map("total_amount")
  approvedAmount    Decimal?  @db.Decimal(14, 2) @map("approved_amount")
  termMonths        Int?      @map("term_months")
  redirectUrl       String?   @map("redirect_url")
  rankingScore      Decimal?  @db.Decimal(10, 4) @map("ranking_score")
  matchLabel        String?   @map("match_label")
  rawPayload        Json?     @map("raw_payload")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  simulation  CreditSimulation  @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  conversions CreditConversion[]
  clicks      CreditOfferClick[]

  @@index([simulationId, createdAt])
  @@index([provider, bankName])
  @@unique([simulationId, externalOfferId])
  @@map("credit_offer_snapshots")
}

model CreditConversion {
  id                   String    @id @default(cuid())
  simulationId         String    @map("simulation_id")
  offerSnapshotId      String?   @map("offer_snapshot_id")
  provider             String    @default("juros_baixos")
  externalConversionId String?   @map("external_conversion_id")
  status               String    @default("pending")
  commissionAmount     Decimal?  @db.Decimal(14, 2) @map("commission_amount")
  convertedAt          DateTime? @map("converted_at")
  rawPayload           Json?     @map("raw_payload")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  simulation   CreditSimulation   @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  offerSnapshot CreditOfferSnapshot? @relation(fields: [offerSnapshotId], references: [id], onDelete: SetNull)

  @@index([simulationId, createdAt])
  @@index([status, convertedAt])
  @@unique([provider, externalConversionId])
  @@map("credit_conversions")
}

model CreditOfferClick {
  id             String   @id @default(cuid())
  simulationId   String   @map("simulation_id")
  offerSnapshotId String  @map("offer_snapshot_id")
  provider       String   @default("juros_baixos")
  sourcePage     String   @map("source_page")
  utmSource      String?  @map("utm_source")
  utmMedium      String?  @map("utm_medium")
  utmCampaign    String?  @map("utm_campaign")
  createdAt      DateTime @default(now()) @map("created_at")

  simulation   CreditSimulation    @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  offerSnapshot CreditOfferSnapshot @relation(fields: [offerSnapshotId], references: [id], onDelete: Cascade)

  @@index([simulationId, createdAt])
  @@index([offerSnapshotId, createdAt])
  @@index([provider, createdAt])
  @@map("credit_offer_clicks")
}

model ClickEvent {
  id          String   @id @default(cuid())
  offerId     String?  @map("offer_id")
  sourcePage  String   @map("source_page")
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  createdAt   DateTime @default(now()) @map("created_at")

  offer Offer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([offerId])
  @@index([sourcePage])
  @@index([createdAt])
  @@map("click_events")
}

model CtaEvent {
  id          String   @id @default(cuid())
  sourcePage  String   @map("source_page")
  ctaName     String   @map("cta_name")
  destination String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([sourcePage])
  @@index([ctaName])
  @@index([createdAt])
  @@map("cta_events")
}

model AppIntegrationEvent {
  id             String   @id @default(cuid())
  sourcePage     String   @map("source_page")
  productContext String?  @map("product_context")
  simulationId   String?  @map("simulation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  simulation SimulationLead? @relation(fields: [simulationId], references: [id], onDelete: SetNull)

  @@index([sourcePage])
  @@index([simulationId])
  @@index([createdAt])
  @@map("app_integration_events")
}

model PartnerRedirect {
  id          String   @id @default(cuid())
  partnerId   String   @map("partner_id")
  offerId     String?  @map("offer_id")
  sourcePage  String   @map("source_page")
  destination String
  createdAt   DateTime @default(now()) @map("created_at")

  offer Offer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([offerId])
  @@index([createdAt])
  @@map("partner_redirects")
}

model AffiliateNetwork {
  id          String               @id @default(cuid())
  code        AffiliateNetworkCode @unique
  name        String
  status      RecordStatus         @default(active)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  programs AffiliateProgram[]
  offers   AffiliateOffer[]

  @@map("affiliate_networks")
}

model AffiliateProgram {
  id            String       @id @default(cuid())
  networkId     String       @map("network_id")
  advertiserId  String       @map("advertiser_id")
  externalProgramId String?  @map("external_program_id")
  merchantName  String       @map("merchant_name")
  programName   String?      @map("program_name")
  description   String?
  imageUrl      String?      @map("image_url")
  category      String?
  payoutText    String?      @map("payout_text")
  status        RecordStatus @default(active)
  metadata      Json?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  network AffiliateNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  offers  AffiliateOffer[]

  @@index([networkId, status])
  @@unique([networkId, advertiserId])
  @@map("affiliate_programs")
}

model AffiliateOffer {
  id                  String               @id @default(cuid())
  networkId           String               @map("network_id")
  programId           String?              @map("program_id")
  network             AffiliateNetworkCode @default(awin)
  advertiserId        String               @map("advertiser_id")
  externalProgramId   String?              @map("external_program_id")
  merchantName        String               @map("merchant_name")
  offerSlug           String               @unique @map("offer_slug")
  title               String
  category            String
  description         String
  audience            String?              @map("audience")
  imageUrl            String?              @map("image_url")
  productType         ProductType?         @map("product_type")
  pageSlugs           String[]             @default([]) @map("page_slugs")
  placements          String[]             @default([])
  destinationUrl      String               @map("destination_url")
  trackingUrl         String               @map("tracking_url")
  payoutText          String?              @map("payout_text")
  ctaText             String               @map("cta_text")
  disclosureText      String               @map("disclosure_text")
  isActive            Boolean              @default(true) @map("is_active")
  priority            Int                  @default(0)
  metadata            Json?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  networkRef AffiliateNetwork  @relation(fields: [networkId], references: [id], onDelete: Cascade)
  program    AffiliateProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  clicks     AffiliateClick[]

  @@index([network, isActive, priority])
  @@index([productType, isActive])
  @@index([advertiserId])
  @@map("affiliate_offers")
}

model AffiliateClick {
  id          String   @id @default(cuid())
  affiliateOfferId String? @map("affiliate_offer_id")
  offerSlug   String   @map("offer_slug")
  pageSlug    String   @map("page_slug")
  position    String
  clickref    String
  device      String
  createdAt   DateTime @default(now()) @map("created_at")

  offer AffiliateOffer? @relation(fields: [affiliateOfferId], references: [id], onDelete: SetNull)

  @@index([affiliateOfferId, createdAt])
  @@index([offerSlug, createdAt])
  @@index([pageSlug, createdAt])
  @@map("affiliate_clicks")
}

model ReactivationLead {
  id                 String                 @id @default(cuid())
  externalLeadId     String?                @map("external_lead_id")
  batchId            String?                @map("batch_id")
  tokenHash          String                 @unique @map("token_hash")
  tokenLast4         String                 @map("token_last4")
  tokenRevokedAt     DateTime?              @map("token_revoked_at")
  tokenRegeneratedAt DateTime?              @map("token_regenerated_at")
  lastUsedAt         DateTime?              @map("last_used_at")
  status             ReactivationLeadStatus @default(imported)
  fullName           String?                @map("full_name")
  email              String?
  phone              String?
  cpfHash            String?                @map("cpf_hash")
  productType        ProductType            @default(loan) @map("product_type")
  source             String?                @map("source")
  segment            String?
  originalPayload    Json?                  @map("original_payload")
  consentGivenAt     DateTime?              @map("consent_given_at")
  consentRefusedAt   DateTime?              @map("consent_refused_at")
  consentRevokedAt   DateTime?              @map("consent_revoked_at")
  consentIp          String?                @map("consent_ip")
  consentUserAgent   String?                @map("consent_user_agent")
  consentVersion     String?                @map("consent_version")
  privacyPolicyVersion String?              @map("privacy_policy_version")
  consentSource      String?                @map("consent_source")
  optOutReason       String?                @map("opt_out_reason")
  requestedAmount    Decimal?               @db.Decimal(14, 2) @map("requested_amount")
  income             Decimal?               @db.Decimal(14, 2)
  employmentStatus   String?                @map("employment_status")
  hasRestriction     Boolean?               @map("has_restriction")
  hasGuarantee       Boolean?               @map("has_guarantee")
  guaranteeType      String?                @map("guarantee_type")
  scoreValue         Int?                   @map("score_value")
  scoreBand          String?                @map("score_band")
  qualification      String?
  selectedPartnerId  String?                @map("selected_partner_id")
  selectedPartnerName String?               @map("selected_partner_name")
  idempotencyKey     String?                @unique @map("idempotency_key")
  submissionHash     String?                @map("submission_hash")
  submittedAt        DateTime?              @map("submitted_at")
  processingLockId   String?                @map("processing_lock_id")
  processingStartedAt DateTime?             @map("processing_started_at")
  processingExpiresAt DateTime?             @map("processing_expires_at")
  deliveryStatus     String?                @map("delivery_status")
  deliveredAt        DateTime?              @map("delivered_at")
  estimatedRevenueCents Int?                @map("estimated_revenue_cents")
  payoutCents        Int?                   @map("payout_cents")
  expiresAt          DateTime?              @map("expires_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  events     ReactivationAuditEvent[]
  deliveries ReactivationPartnerDelivery[]
  emailMessages ReactivationEmailMessage[]
  flowExecutions ReactivationLeadFlowExecution[]
  flowSteps ReactivationFlowExecutionStep[]

  @@index([batchId, status])
  @@index([status, createdAt])
  @@index([segment])
  @@index([selectedPartnerId, createdAt])
  @@index([processingLockId])
  @@index([deliveryStatus, updatedAt])
  @@map("reactivation_leads")
}

model ReactivationAuditEvent {
  id          String        @id @default(cuid())
  leadId      String?       @map("lead_id")
  eventType   LgpdEventType @map("event_type")
  actor       String        @default("system")
  ipAddress   String?       @map("ip_address")
  userAgent   String?       @map("user_agent")
  source      String?
  idempotencyKey String? @unique @map("idempotency_key")
  metadata    Json?
  createdAt   DateTime      @default(now()) @map("created_at")

  lead ReactivationLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([eventType, createdAt])
  @@map("reactivation_audit_events")
}

model ReactivationPartnerDelivery {
  id             String                  @id @default(cuid())
  leadId         String                  @map("lead_id")
  partnerId      String                  @map("partner_id")
  partnerName    String                  @map("partner_name")
  mode           ReactivationPartnerMode
  status         String                  @default("pending")
  destination    String?
  idempotencyKey String                  @unique @map("idempotency_key")
  retryCount     Int                     @default(0) @map("retry_count")
  nextAttemptAt  DateTime?               @map("next_attempt_at")
  lastAttemptAt  DateTime?               @map("last_attempt_at")
  deliveredAt    DateTime?               @map("delivered_at")
  requestPayload Json?                   @map("request_payload")
  responsePayload Json?                  @map("response_payload")
  errorMessage   String?                 @map("error_message")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  lead ReactivationLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([partnerId, status])
  @@index([status, createdAt])
  @@index([nextAttemptAt, status])
  @@unique([leadId, partnerId])
  @@map("reactivation_partner_deliveries")
}

model ReactivationSuppression {
  id        String                      @id @default(cuid())
  scope     ReactivationSuppressionScope
  emailHash String?                     @map("email_hash")
  phoneHash String?                     @map("phone_hash")
  cpfHash   String?                     @map("cpf_hash")
  reason    String?
  source    String?
  createdAt DateTime                    @default(now()) @map("created_at")

  @@index([scope, createdAt])
  @@index([emailHash, scope])
  @@index([phoneHash, scope])
  @@index([cpfHash, scope])
  @@unique([emailHash, scope])
  @@unique([phoneHash, scope])
  @@unique([cpfHash, scope])
  @@map("reactivation_suppressions")
}

model ReactivationEmailCampaign {
  id               String              @id @default(cuid())
  name             String
  slug             String              @unique
  description      String?
  status           EmailCampaignStatus @default(draft)
  isActive         Boolean             @default(false) @map("is_active")
  startsAt         DateTime?           @map("starts_at")
  endsAt           DateTime?           @map("ends_at")
  initialTemplateId String?            @map("initial_template_id")
  reminderTemplateId String?           @map("reminder_template_id")
  lastCallTemplateId String?           @map("last_call_template_id")
  flowDefinitionId String?             @map("flow_definition_id")
  publishedFlowVersionId String?       @map("published_flow_version_id")
  dailyLimit       Int                 @default(5) @map("daily_limit")
  batchSize        Int                 @default(5) @map("batch_size")
  sendWindow       Json?               @map("send_window")
  exitRules        Json?               @map("exit_rules")
  metadata         Json?
  createdBy        String?             @map("created_by")
  updatedBy        String?             @map("updated_by")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  messages ReactivationEmailMessage[]

  @@index([status, isActive])
  @@index([startsAt, endsAt])
  @@map("reactivation_email_campaigns")
}

model ReactivationEmailTemplate {
  id          String              @id @default(cuid())
  name        String
  slug        String
  version     Int                 @default(1)
  status      EmailTemplateStatus @default(draft)
  isActive    Boolean             @default(false) @map("is_active")
  subject     String
  preheader   String?
  html        String              @db.Text
  text        String              @db.Text
  variables   String[]            @default([])
  metadata    Json?
  parentId    String?             @map("parent_id")
  createdBy   String?             @map("created_by")
  updatedBy   String?             @map("updated_by")
  publishedAt DateTime?           @map("published_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  messages ReactivationEmailMessage[]

  @@unique([slug, version])
  @@index([slug, status])
  @@index([status, isActive])
  @@map("reactivation_email_templates")
}

model ReactivationEmailMessage {
  id              String             @id @default(cuid())
  leadId          String?            @map("lead_id")
  campaignId      String?            @map("campaign_id")
  templateId      String?            @map("template_id")
  flowExecutionId String?            @map("flow_execution_id")
  stepKey         String?            @map("step_key")
  sequenceKey     String?            @map("sequence_key")
  provider        String             @default("sendgrid")
  providerMessageId String?          @map("provider_message_id")
  toEmailHash     String?            @map("to_email_hash")
  toEmailMasked   String?            @map("to_email_masked")
  subject         String?
  status          EmailMessageStatus @default(queued)
  idempotencyKey  String?            @unique @map("idempotency_key")
  requestPayload  Json?              @map("request_payload")
  responsePayload Json?              @map("response_payload")
  errorMessage    String?            @map("error_message")
  scheduledAt     DateTime?          @map("scheduled_at")
  sentAt          DateTime?          @map("sent_at")
  deliveredAt     DateTime?          @map("delivered_at")
  openedAt        DateTime?          @map("opened_at")
  clickedAt       DateTime?          @map("clicked_at")
  bouncedAt       DateTime?          @map("bounced_at")
  unsubscribedAt  DateTime?          @map("unsubscribed_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  lead      ReactivationLead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  campaign  ReactivationEmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  template  ReactivationEmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  events    ReactivationEmailMessageEvent[]

  @@index([leadId, createdAt])
  @@index([campaignId, status, createdAt])
  @@index([providerMessageId])
  @@index([status, scheduledAt])
  @@map("reactivation_email_messages")
}

model ReactivationEmailMessageEvent {
  id              String         @id @default(cuid())
  messageId       String?        @map("message_id")
  leadId          String?        @map("lead_id")
  campaignId      String?        @map("campaign_id")
  eventType       EmailEventType @map("event_type")
  provider        String         @default("sendgrid")
  providerEventId String?        @map("provider_event_id")
  providerMessageId String?      @map("provider_message_id")
  emailHash       String?        @map("email_hash")
  url             String?        @db.Text
  userAgent       String?        @map("user_agent")
  ipAddress       String?        @map("ip_address")
  reason          String?
  rawPayload      Json?          @map("raw_payload")
  signatureVerified Boolean      @default(false) @map("signature_verified")
  occurredAt      DateTime       @default(now()) @map("occurred_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  message ReactivationEmailMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([messageId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([campaignId, eventType, occurredAt])
  @@index([providerMessageId])
  @@map("reactivation_email_message_events")
}

model ReactivationFlowDefinition {
  id                String               @id @default(cuid())
  name              String
  slug              String               @unique
  description       String?
  status            AutomationFlowStatus @default(draft)
  isActive          Boolean              @default(false) @map("is_active")
  publishedVersionId String?             @map("published_version_id")
  metadata          Json?
  createdBy         String?              @map("created_by")
  updatedBy         String?              @map("updated_by")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  versions ReactivationFlowVersion[]
  executions ReactivationLeadFlowExecution[]

  @@index([status, isActive])
  @@map("reactivation_flow_definitions")
}

model ReactivationFlowVersion {
  id           String    @id @default(cuid())
  flowId       String    @map("flow_id")
  version      Int
  status       String    @default("draft")
  definition   Json
  validationErrors Json? @map("validation_errors")
  publishedAt  DateTime? @map("published_at")
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  flow       ReactivationFlowDefinition @relation(fields: [flowId], references: [id], onDelete: Cascade)
  nodes      ReactivationFlowNode[]
  edges      ReactivationFlowEdge[]
  executions ReactivationLeadFlowExecution[]

  @@unique([flowId, version])
  @@index([flowId, status])
  @@map("reactivation_flow_versions")
}

model ReactivationFlowNode {
  id            String             @id @default(cuid())
  flowVersionId String             @map("flow_version_id")
  nodeKey       String             @map("node_key")
  type          AutomationNodeType
  label         String
  config        Json?
  position      Json?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  flowVersion ReactivationFlowVersion @relation(fields: [flowVersionId], references: [id], onDelete: Cascade)
  steps       ReactivationFlowExecutionStep[]

  @@unique([flowVersionId, nodeKey])
  @@index([flowVersionId, type])
  @@map("reactivation_flow_nodes")
}

model ReactivationFlowEdge {
  id            String   @id @default(cuid())
  flowVersionId String   @map("flow_version_id")
  edgeKey       String   @map("edge_key")
  sourceNodeKey String   @map("source_node_key")
  targetNodeKey String   @map("target_node_key")
  label         String?
  condition     Json?
  createdAt     DateTime @default(now()) @map("created_at")

  flowVersion ReactivationFlowVersion @relation(fields: [flowVersionId], references: [id], onDelete: Cascade)

  @@unique([flowVersionId, edgeKey])
  @@index([flowVersionId, sourceNodeKey])
  @@map("reactivation_flow_edges")
}

model ReactivationLeadFlowExecution {
  id              String                    @id @default(cuid())
  leadId          String                    @map("lead_id")
  campaignId      String?                   @map("campaign_id")
  flowId          String                    @map("flow_id")
  flowVersionId   String                    @map("flow_version_id")
  currentNodeKey  String?                   @map("current_node_key")
  status          AutomationExecutionStatus @default(active)
  context         Json?
  startedAt       DateTime                  @default(now()) @map("started_at")
  waitingUntil    DateTime?                 @map("waiting_until")
  completedAt     DateTime?                 @map("completed_at")
  failedAt        DateTime?                 @map("failed_at")
  errorMessage    String?                   @map("error_message")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  lead        ReactivationLead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  flow        ReactivationFlowDefinition @relation(fields: [flowId], references: [id], onDelete: Restrict)
  flowVersion ReactivationFlowVersion    @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)
  steps       ReactivationFlowExecutionStep[]

  @@index([leadId, status])
  @@index([campaignId, status])
  @@index([flowVersionId, status])
  @@index([currentNodeKey, status])
  @@map("reactivation_lead_flow_executions")
}

model ReactivationFlowExecutionStep {
  id              String               @id @default(cuid())
  executionId     String               @map("execution_id")
  leadId          String?              @map("lead_id")
  flowNodeId      String?              @map("flow_node_id")
  nodeKey         String               @map("node_key")
  nodeType        AutomationNodeType    @map("node_type")
  status          AutomationStepStatus  @default(pending)
  input           Json?
  output          Json?
  errorMessage    String?              @map("error_message")
  startedAt       DateTime?            @map("started_at")
  completedAt     DateTime?            @map("completed_at")
  createdAt       DateTime             @default(now()) @map("created_at")

  execution ReactivationLeadFlowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  lead      ReactivationLead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  flowNode  ReactivationFlowNode?         @relation(fields: [flowNodeId], references: [id], onDelete: SetNull)

  @@index([executionId, createdAt])
  @@index([leadId, createdAt])
  @@index([nodeKey, status])
  @@map("reactivation_flow_execution_steps")
}

model ReactivationAdminAuditLog {
  id          String           @id @default(cuid())
  actor       String           @default("system")
  action      AdminAuditAction
  entityType  String           @map("entity_type")
  entityId    String?          @map("entity_id")
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?          @map("ip_address")
  userAgent   String?          @map("user_agent")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([actor, createdAt])
  @@map("reactivation_admin_audit_logs")
}

model ReactivationAdminConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("reactivation_admin_config")
}

model ReactivationAutomationJobRun {
  id             String   @id @default(cuid())
  jobName        String   @map("job_name")
  status         String
  triggerSource  String?  @map("trigger_source")
  startedAt      DateTime @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  durationMs     Int?     @map("duration_ms")
  processedCount Int?     @map("processed_count")
  successCount   Int?     @map("success_count")
  errorCount     Int?     @map("error_count")
  metadata       Json?
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([jobName, startedAt])
  @@index([status, startedAt])
  @@map("reactivation_automation_job_runs")
}
