generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductType {
  loan
  credit_card
  financing
}

enum CategoryType {
  blog
  product
}

enum RecordStatus {
  draft
  published
  archived
  active
  inactive
}

enum EditorialBriefStatus {
  planned
  briefing_ready
  generating
  draft
  published
  failed
}

enum EditorialIntentStage {
  pillar
  top
  middle
  bottom
}

enum EditorialJobStatus {
  queued
  running
  succeeded
  failed
  draft_saved
}

enum EditorialImageProvider {
  openai
  gemini
  fallback
}

enum AffiliateNetworkCode {
  awin
  admitad
}

enum ReactivationLeadStatus {
  imported
  visited
  consented
  qualified
  routed
  pending_delivery
  delivery_retrying
  delivery_failed
  delivery_success
  rejected
  expired
  revoked
  suppressed
}

enum ReactivationPartnerMode {
  webhook
  redirect
  email
  whatsapp
}

enum LgpdEventType {
  lead_imported
  link_generated
  token_regenerated
  token_revoked
  page_viewed
  consent_granted
  consent_refused
  consent_revoked
  opt_out_registered
  form_submitted
  duplicate_submit_ignored
  lead_scored
  partner_selected
  partner_routed
  partner_route_failed
  delivery_retry_scheduled
  suppression_checked
  notification_sent
  token_expired
  data_exported
}

enum ReactivationSuppressionScope {
  unsubscribe_email
  unsubscribe_whatsapp
  dnc_global
  revoked_consent
}

enum EmailCampaignStatus {
  draft
  active
  paused
  completed
  archived
}

enum EmailTemplateStatus {
  draft
  active
  inactive
  archived
}

enum EmailMessageStatus {
  queued
  sending
  sent
  delivered
  opened
  clicked
  bounced
  dropped
  spam_reported
  unsubscribed
  failed
  suppressed
  cancelled
}

enum EmailEventType {
  processed
  delivered
  open
  click
  bounce
  dropped
  deferred
  spamreport
  unsubscribe
  group_unsubscribe
  group_resubscribe
  sent
  failed
  suppressed
  manual_resend
}

enum AutomationFlowStatus {
  draft
  active
  paused
  archived
}

enum AutomationNodeType {
  trigger_lead_entry
  eligibility_filter
  delay
  send_email
  condition
  behavior_split
  wait_event
  mark_status
  add_suppression
  end_flow
  webhook_event
  route_partner
  update_lead_field
}

enum AutomationExecutionStatus {
  active
  waiting
  paused
  completed
  failed
  cancelled
}

enum AutomationStepStatus {
  pending
  running
  waiting
  completed
  failed
  skipped
}

enum AdminUserStatus {
  active
  invited
  disabled
}

enum AdminSessionStatus {
  active
  revoked
  expired
}

enum LeadSuppressionScope {
  manual
  invalid
  duplicated
  opt_out
  blocked
}

enum PartnerIntegrationType {
  tracking_link
  webhook
  api
  manual
}

enum AdminAuditAction {
  campaign_created
  campaign_updated
  campaign_paused
  campaign_activated
  campaign_archived
  campaign_duplicated
  template_created
  template_updated
  template_published
  flow_created
  flow_updated
  flow_published
  flow_paused
  flow_activated
  lead_email_resent
  lead_flow_moved
  lead_paused
  lead_suppressed
  config_updated
  webhook_received
}

model Bank {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  website   String?
  status    RecordStatus @default(active)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offers         Offer[]
  partnerConfigs PartnerConfig[]

  @@index([name])
  @@map("banks")
}

model Category {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  type      CategoryType
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  products FinancialProduct[]
  articles Article[]

  @@index([type])
  @@map("categories")
}

model FinancialProduct {
  id          String      @id @default(cuid())
  type        ProductType
  name        String
  description String?
  categoryId  String?     @map("category_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  offers   Offer[]

  @@index([type])
  @@index([categoryId])
  @@map("financial_products")
}

model Offer {
  id                 String       @id @default(cuid())
  bankId             String       @map("bank_id")
  productId          String       @map("product_id")
  interestRate       Decimal?     @db.Decimal(10, 4) @map("interest_rate")
  cet                Decimal?     @db.Decimal(10, 4)
  minAmount          Decimal?     @db.Decimal(14, 2) @map("min_amount")
  maxAmount          Decimal?     @db.Decimal(14, 2) @map("max_amount")
  minTerm            Int?         @map("min_term")
  maxTerm            Int?         @map("max_term")
  scoreRequirement   String?      @map("score_requirement")
  redirectUrl        String       @map("redirect_url")
  partnerTrackingUrl String?      @map("partner_tracking_url")
  isFeatured         Boolean      @default(false) @map("is_featured")
  status             RecordStatus @default(active)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  bank     Bank             @relation(fields: [bankId], references: [id], onDelete: Cascade)
  product  FinancialProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  clicks   ClickEvent[]
  redirects PartnerRedirect[]

  @@index([bankId])
  @@index([productId])
  @@index([status, isFeatured])
  @@map("offers")
}

model Article {
  id             String       @id @default(cuid())
  slug           String       @unique
  title          String
  content        String
  excerpt        String?
  categoryId     String?      @map("category_id")
  clusterId      String?      @map("cluster_id")
  briefId        String?      @unique @map("brief_id")
  author         String?
  seoTitle       String?      @map("seo_title")
  seoDescription String?      @map("seo_description")
  coverImage     String?      @map("cover_image")
  ogImage        String?      @map("og_image")
  readTime       Int?         @map("read_time")
  wordCount      Int?         @map("word_count")
  isPillar       Boolean      @default(false) @map("is_pillar")
  structuredContent Json?     @map("structured_content")
  publishedAt    DateTime?    @map("published_at")
  status         RecordStatus @default(draft)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cluster  SeoCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  brief    EditorialBrief? @relation(fields: [briefId], references: [id], onDelete: SetNull)
  assets   EditorialAsset[]
  jobRuns  EditorialJobRun[]
  usedImages BlogUsedImage[]
  automationJobs AutomationJob[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([clusterId])
  @@index([isPillar, status])
  @@map("articles")
}

model AutomationJob {
  id                String    @id @default(cuid())
  jobName           String    @map("job_name")
  startedAt         DateTime  @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  status            String
  errorMessage      String?   @map("error_message")
  payload           Json?
  result            Json?
  createdArticleId  String?   @map("created_article_id")
  wordpressPostId   Int?      @map("wordpress_post_id")

  article Article? @relation(fields: [createdArticleId], references: [id], onDelete: SetNull)

  @@index([jobName, startedAt])
  @@index([status, startedAt])
  @@index([createdArticleId])
  @@index([wordpressPostId])
  @@map("automation_jobs")
}

model BlogUsedImage {
  id             String   @id @default(cuid())
  postId         String?  @map("post_id")
  source         String
  sourceImageId  String?  @map("source_image_id")
  originalUrl    String?  @map("original_url")
  downloadUrl    String?  @map("download_url")
  imageHash      String?  @map("image_hash")
  perceptualHash String?  @map("perceptual_hash")
  visualSignature String? @map("visual_signature")
  keywords       Json?
  articleTitle   String?  @map("article_title")
  usedAt         DateTime @default(now()) @map("used_at")
  createdAt      DateTime @default(now()) @map("created_at")

  article Article? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@unique([source, sourceImageId])
  @@unique([originalUrl])
  @@unique([downloadUrl])
  @@unique([imageHash])
  @@index([postId])
  @@index([source])
  @@index([usedAt])
  @@map("blog_used_images")
}

model SeoCluster {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  primaryKeyword String       @map("primary_keyword")
  pillarTitle    String       @map("pillar_title")
  pillarSlug     String       @unique @map("pillar_slug")
  description    String?
  status         RecordStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  articles Article[]
  briefs   EditorialBrief[]
  jobRuns  EditorialJobRun[]

  @@index([status, createdAt])
  @@map("seo_clusters")
}

model EditorialBrief {
  id                 String               @id @default(cuid())
  clusterId          String               @map("cluster_id")
  slug               String               @unique
  title              String
  primaryKeyword     String               @map("primary_keyword")
  secondaryKeywords  Json?                @map("secondary_keywords")
  stage              EditorialIntentStage
  brief              Json
  seoTitle           String?              @map("seo_title")
  metaDescription    String?              @map("meta_description")
  scheduledFor       DateTime?            @map("scheduled_for")
  status             EditorialBriefStatus @default(planned)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  cluster SeoCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  article Article?
  jobRuns EditorialJobRun[]

  @@index([clusterId, status])
  @@index([scheduledFor, status])
  @@map("editorial_briefs")
}

model EditorialAsset {
  id            String                @id @default(cuid())
  articleId     String                @map("article_id")
  slug          String
  provider      EditorialImageProvider
  prompt        String
  publicPath    String                @map("public_path")
  width         Int?
  height        Int?
  fileSizeBytes Int?                  @map("file_size_bytes")
  status        EditorialJobStatus    @default(queued)
  errorMessage  String?               @map("error_message")
  metadata      Json?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([slug, createdAt])
  @@map("editorial_assets")
}

model EditorialJobRun {
  id            String             @id @default(cuid())
  jobName       String             @map("job_name")
  triggerSource String?            @map("trigger_source")
  clusterId     String?            @map("cluster_id")
  briefId       String?            @map("brief_id")
  articleId     String?            @map("article_id")
  status        EditorialJobStatus @default(queued)
  startedAt     DateTime           @default(now()) @map("started_at")
  finishedAt    DateTime?          @map("finished_at")
  durationMs    Int?               @map("duration_ms")
  metadata      Json?
  errorMessage  String?            @map("error_message")
  createdAt     DateTime           @default(now()) @map("created_at")

  cluster SeoCluster?      @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  brief   EditorialBrief?  @relation(fields: [briefId], references: [id], onDelete: SetNull)
  article Article?         @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([jobName, startedAt])
  @@index([status, startedAt])
  @@index([clusterId, startedAt])
  @@index([briefId, startedAt])
  @@map("editorial_job_runs")
}

model SeoSearchConsoleMetric {
  id          String   @id @default(cuid())
  siteUrl     String   @map("site_url")
  page        String
  query       String
  dateFrom    DateTime @map("date_from")
  dateTo      DateTime @map("date_to")
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Decimal  @default(0) @db.Decimal(10, 6)
  position    Decimal  @default(0) @db.Decimal(10, 3)
  source      String   @default("search_console")
  syncedAt    DateTime @default(now()) @map("synced_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([siteUrl, page, query, dateFrom, dateTo])
  @@index([page])
  @@index([query])
  @@index([dateTo])
  @@index([impressions])
  @@index([position])
  @@map("seo_search_console_metrics")
}

model CompetitorSeoOpportunity {
  id               String   @id @default(cuid())
  query            String
  clusterSlug      String?  @map("cluster_slug")
  clusterName      String?  @map("cluster_name")
  competitorDomain String   @map("competitor_domain")
  competitorUrl    String   @map("competitor_url")
  competitorTitle  String?  @map("competitor_title")
  snippet          String?
  position         Int?
  score            Int      @default(0)
  opportunityType  String   @default("content_gap") @map("opportunity_type")
  gapReason        String?  @map("gap_reason")
  recommendedTitle String?  @map("recommended_title")
  recommendedSlug  String?  @map("recommended_slug")
  status           String   @default("new")
  rawResult        Json?    @map("raw_result")
  analyzedAt       DateTime @default(now()) @map("analyzed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([query, competitorUrl])
  @@index([clusterSlug])
  @@index([competitorDomain])
  @@index([score])
  @@index([status, analyzedAt])
  @@map("competitor_seo_opportunities")
}

model SimulationLead {
  id               String      @id @default(cuid())
  productType      ProductType @map("product_type")
  requestedAmount  Decimal?    @db.Decimal(14, 2) @map("requested_amount")
  income           Decimal?    @db.Decimal(14, 2)
  scoreRange       String?     @map("score_range")
  employmentStatus String?     @map("employment_status")
  hasRestriction   Boolean?    @map("has_restriction")
  fullName         String?     @map("full_name")
  phone            String?
  profile          String?
  partnerId        String?     @map("partner_id")
  partnerName      String?     @map("partner_name")
  deliveryMode     String?     @map("delivery_mode")
  redirectUrl      String?     @map("redirect_url")
  status           String      @default("new")
  utmSource        String?     @map("utm_source")
  utmMedium        String?     @map("utm_medium")
  utmCampaign      String?     @map("utm_campaign")
  originPage       String?     @map("origin_page")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  appIntegrationEvents AppIntegrationEvent[]
  tagAssignments       LeadTagAssignment[]
  ownerAssignment      LeadOwnerAssignment?
  notes                LeadNote[]
  primaryMerges        LeadMerge[] @relation("PrimaryLeadMerge")
  mergedInto           LeadMerge[] @relation("MergedLeadMerge")
  routingDecisions     LeadRoutingDecision[]
  deliveryAttempts     LeadDeliveryAttempt[]
  suppressions         LeadSuppression[]
  scoreSnapshots       LeadScoreSnapshot[]
  revenueEvents        RevenueEvent[]
  payoutEvents         PayoutEvent[]

  @@index([productType])
  @@index([originPage])
  @@index([profile])
  @@index([partnerId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("simulation_leads")
}

model CreditLead {
  id               String      @id @default(cuid())
  fullName         String      @map("full_name")
  cpf              String
  email            String?
  phone            String?
  birthDate        DateTime?   @map("birth_date")
  mothersName      String?     @map("mothers_name")
  gender           String?
  maritalStatus    String?     @map("marital_status")
  educationalLevel String?     @map("educational_level")
  birthCity        String?     @map("birth_city")
  birthState       String?     @map("birth_state")
  address          String?
  addressNumber    String?     @map("address_number")
  district         String?
  city             String?
  state            String?
  zipCode          String?     @map("zip_code")
  requestedAmount  Decimal?    @db.Decimal(14, 2) @map("requested_amount")
  income           Decimal?    @db.Decimal(14, 2)
  scoreRange       String?     @map("score_range")
  employmentStatus String?     @map("employment_status")
  hasRestriction   Boolean?    @map("has_restriction")
  productType      ProductType @map("product_type")
  sourcePage       String?     @map("source_page")
  utmSource        String?     @map("utm_source")
  utmMedium        String?     @map("utm_medium")
  utmCampaign      String?     @map("utm_campaign")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  providerSessions CreditProviderSession[]
  simulations      CreditSimulation[]

  @@index([cpf])
  @@index([productType, createdAt])
  @@index([sourcePage, createdAt])
  @@map("credit_leads")
}

model CreditProviderSession {
  id                String    @id @default(cuid())
  leadId            String    @map("lead_id")
  provider          String    @default("juros_baixos")
  externalUserId    String?   @map("external_user_id")
  externalSessionId String?   @map("external_session_id")
  externalJwt       String?   @db.Text @map("external_jwt")
  tokenExpiresAt    DateTime? @map("token_expires_at")
  status            String    @default("pending")
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  lead        CreditLead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  simulations CreditSimulation[]

  @@index([leadId, provider])
  @@index([status, updatedAt])
  @@unique([provider, externalUserId])
  @@unique([provider, externalSessionId])
  @@map("credit_provider_sessions")
}

model CreditSimulation {
  id                   String      @id @default(cuid())
  leadId               String      @map("lead_id")
  providerSessionId    String?     @map("provider_session_id")
  provider             String      @default("juros_baixos")
  externalSimulationId String?     @map("external_simulation_id")
  requestedAmount      Decimal?    @db.Decimal(14, 2) @map("requested_amount")
  installments         Int?
  productType          ProductType @map("product_type")
  status               String      @default("pending")
  rawRequest           Json?       @map("raw_request")
  rawResponse          Json?       @map("raw_response")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  lead            CreditLead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  providerSession CreditProviderSession? @relation(fields: [providerSessionId], references: [id], onDelete: SetNull)
  offers          CreditOfferSnapshot[]
  conversions     CreditConversion[]
  clicks          CreditOfferClick[]

  @@index([leadId, createdAt])
  @@index([providerSessionId, createdAt])
  @@index([provider, status, createdAt])
  @@unique([provider, externalSimulationId])
  @@map("credit_simulations")
}

model CreditOfferSnapshot {
  id                String    @id @default(cuid())
  simulationId      String    @map("simulation_id")
  provider          String    @default("juros_baixos")
  externalOfferId   String?   @map("external_offer_id")
  bankName          String    @map("bank_name")
  productName       String    @map("product_name")
  monthlyRate       Decimal?  @db.Decimal(10, 4) @map("monthly_rate")
  cet               Decimal?  @db.Decimal(10, 4)
  installmentAmount Decimal?  @db.Decimal(14, 2) @map("installment_amount")
  totalAmount       Decimal?  @db.Decimal(14, 2) @map("total_amount")
  approvedAmount    Decimal?  @db.Decimal(14, 2) @map("approved_amount")
  termMonths        Int?      @map("term_months")
  redirectUrl       String?   @map("redirect_url")
  rankingScore      Decimal?  @db.Decimal(10, 4) @map("ranking_score")
  matchLabel        String?   @map("match_label")
  rawPayload        Json?     @map("raw_payload")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  simulation  CreditSimulation  @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  conversions CreditConversion[]
  clicks      CreditOfferClick[]

  @@index([simulationId, createdAt])
  @@index([provider, bankName])
  @@unique([simulationId, externalOfferId])
  @@map("credit_offer_snapshots")
}

model CreditConversion {
  id                   String    @id @default(cuid())
  simulationId         String    @map("simulation_id")
  offerSnapshotId      String?   @map("offer_snapshot_id")
  provider             String    @default("juros_baixos")
  externalConversionId String?   @map("external_conversion_id")
  status               String    @default("pending")
  commissionAmount     Decimal?  @db.Decimal(14, 2) @map("commission_amount")
  convertedAt          DateTime? @map("converted_at")
  rawPayload           Json?     @map("raw_payload")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  simulation   CreditSimulation   @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  offerSnapshot CreditOfferSnapshot? @relation(fields: [offerSnapshotId], references: [id], onDelete: SetNull)

  @@index([simulationId, createdAt])
  @@index([status, convertedAt])
  @@unique([provider, externalConversionId])
  @@map("credit_conversions")
}

model CreditOfferClick {
  id             String   @id @default(cuid())
  simulationId   String   @map("simulation_id")
  offerSnapshotId String  @map("offer_snapshot_id")
  provider       String   @default("juros_baixos")
  sourcePage     String   @map("source_page")
  utmSource      String?  @map("utm_source")
  utmMedium      String?  @map("utm_medium")
  utmCampaign    String?  @map("utm_campaign")
  createdAt      DateTime @default(now()) @map("created_at")

  simulation   CreditSimulation    @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  offerSnapshot CreditOfferSnapshot @relation(fields: [offerSnapshotId], references: [id], onDelete: Cascade)

  @@index([simulationId, createdAt])
  @@index([offerSnapshotId, createdAt])
  @@index([provider, createdAt])
  @@map("credit_offer_clicks")
}

model ClickEvent {
  id          String   @id @default(cuid())
  offerId     String?  @map("offer_id")
  sourcePage  String   @map("source_page")
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  createdAt   DateTime @default(now()) @map("created_at")

  offer Offer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([offerId])
  @@index([sourcePage])
  @@index([createdAt])
  @@map("click_events")
}

model CtaEvent {
  id          String   @id @default(cuid())
  sourcePage  String   @map("source_page")
  ctaName     String   @map("cta_name")
  destination String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([sourcePage])
  @@index([ctaName])
  @@index([createdAt])
  @@map("cta_events")
}

model AppIntegrationEvent {
  id             String   @id @default(cuid())
  sourcePage     String   @map("source_page")
  productContext String?  @map("product_context")
  simulationId   String?  @map("simulation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  simulation SimulationLead? @relation(fields: [simulationId], references: [id], onDelete: SetNull)

  @@index([sourcePage])
  @@index([simulationId])
