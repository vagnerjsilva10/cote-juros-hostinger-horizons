  id           String          @id @default(cuid())
  roleId       String          @map("role_id")
  permissionId String          @map("permission_id")
  createdAt    DateTime        @default(now()) @map("created_at")

  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("admin_role_permissions")
}

model AdminUserRole {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  roleId    String    @map("role_id")
  createdAt DateTime  @default(now()) @map("created_at")

  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("admin_user_roles")
}

model AdminSession {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  sessionHash String             @unique @map("session_hash")
  status      AdminSessionStatus @default(active)
  ipAddress   String?            @map("ip_address")
  userAgent   String?            @map("user_agent")
  lastSeenAt  DateTime?          @map("last_seen_at")
  expiresAt   DateTime           @map("expires_at")
  revokedAt   DateTime?          @map("revoked_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  user        AdminUser          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("admin_sessions")
}

model AdminLoginAttempt {
  id            String     @id @default(cuid())
  userId        String?    @map("user_id")
  email         String?
  ipAddress     String?    @map("ip_address")
  userAgent     String?    @map("user_agent")
  success       Boolean    @default(false)
  failureReason String?    @map("failure_reason")
  createdAt     DateTime   @default(now()) @map("created_at")

  user          AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("admin_login_attempts")
}

model AdminPasswordResetToken {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  tokenHash   String     @unique @map("token_hash")
  expiresAt   DateTime   @map("expires_at")
  usedAt      DateTime?  @map("used_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  user        AdminUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("admin_password_reset_tokens")
}

model AdminAuditLog {
  id           String      @id @default(cuid())
  actorUserId  String?     @map("actor_user_id")
  actorEmail   String?     @map("actor_email")
  action       String
  resource     String
  resourceId   String?     @map("resource_id")
  before       Json?
  after        Json?
  metadata     Json?
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  createdAt    DateTime    @default(now()) @map("created_at")

  actorUser    AdminUser?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([resource, resourceId, createdAt])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
  @@map("admin_audit_logs")
}

model FeatureFlag {
  id          String    @id @default(cuid())
  key         String    @unique
  description String?
  enabled     Boolean   @default(false)
  payload     Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  group       String   @map("setting_group")
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([group, isPublic])
  @@map("site_settings")
}

model NavigationItem {
  id        String   @id @default(cuid())
  location  String
  label     String
  href      String
  order     Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   NavigationItem?  @relation("NavigationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children NavigationItem[] @relation("NavigationHierarchy")

  @@index([location, isActive, order])
  @@index([parentId])
  @@map("navigation_items")
}

model LegalDisclaimer {
  id        String   @id @default(cuid())
  key       String
  title     String
  content   String
  placement String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, placement])
  @@index([placement, isActive])
  @@map("legal_disclaimers")
}

model SeoMeta {
  id            String   @id @default(cuid())
  path          String   @unique
  title         String
  description   String
  canonical     String?
  robots        String?
  ogTitle       String?  @map("og_title")
  ogDescription String?  @map("og_description")
  ogImage       String?  @map("og_image")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive, path])
  @@map("seo_meta")
}

model LeadTag {
  id          String              @id @default(cuid())
  key         String              @unique
  label       String
  color       String?
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  assignments LeadTagAssignment[]

  @@map("lead_tags")
}

model LeadTagAssignment {
  id        String         @id @default(cuid())
  leadId    String         @map("lead_id")
  tagId     String         @map("tag_id")
  createdAt DateTime       @default(now()) @map("created_at")

  lead      SimulationLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag       LeadTag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([leadId, tagId])
  @@index([tagId])
  @@map("lead_tag_assignments")
}

model LeadOwnerAssignment {
  id          String        @id @default(cuid())
  leadId       String       @unique @map("lead_id")
  ownerUserId  String       @map("owner_user_id")
  note         String?
  assignedAt   DateTime     @default(now()) @map("assigned_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  lead         SimulationLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ownerUser    AdminUser      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, assignedAt])
  @@map("lead_owner_assignments")
}

model LeadNote {
  id           String         @id @default(cuid())
  leadId        String        @map("lead_id")
  authorUserId  String?       @map("author_user_id")
  body          String
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  lead          SimulationLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorUser    AdminUser?     @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_notes")
}

model LeadMerge {
  id             String         @id @default(cuid())
  primaryLeadId  String         @map("primary_lead_id")
  mergedLeadId   String         @unique @map("merged_lead_id")
  mergedByUserId String?        @map("merged_by_user_id")
  reason         String?
  createdAt      DateTime       @default(now()) @map("created_at")

  primaryLead    SimulationLead @relation("PrimaryLeadMerge", fields: [primaryLeadId], references: [id], onDelete: Cascade)
  mergedLead     SimulationLead @relation("MergedLeadMerge", fields: [mergedLeadId], references: [id], onDelete: Cascade)
  mergedByUser   AdminUser?     @relation(fields: [mergedByUserId], references: [id], onDelete: SetNull)

  @@index([primaryLeadId, createdAt])
  @@map("lead_merges")
}

model LeadRoutingDecision {
  id            String         @id @default(cuid())
  leadId         String        @map("lead_id")
  routeType      String?       @map("route_type")
  inputSnapshot  Json?         @map("input_snapshot")
  ruleMatched    String?       @map("rule_matched")
  partnerId      String?       @map("partner_id")
  partnerName    String?       @map("partner_name")
  fallbackUsed   Boolean       @default(false) @map("fallback_used")
  reason         String?
  scoreValue     Int?          @map("score_value")
  scoreBand      String?       @map("score_band")
  createdAt      DateTime      @default(now()) @map("created_at")

  lead           SimulationLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([partnerId, createdAt])
  @@map("lead_routing_decisions")
}

model LeadDeliveryAttempt {
  id              String         @id @default(cuid())
  leadId           String        @map("lead_id")
  partnerId        String?       @map("partner_id")
  partnerName      String?       @map("partner_name")
  mode             String?
  status           String        @default("pending")
  requestPayload   Json?         @map("request_payload")
  responsePayload  Json?         @map("response_payload")
  errorMessage     String?       @map("error_message")
  attemptedAt      DateTime      @default(now()) @map("attempted_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  lead             SimulationLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, attemptedAt])
  @@index([partnerId, status])
  @@map("lead_delivery_attempts")
}

model LeadSuppression {
  id         String               @id @default(cuid())
  leadId      String?             @map("lead_id")
  scope       LeadSuppressionScope @default(manual)
  reason      String?
  source      String?
  createdAt   DateTime            @default(now()) @map("created_at")

  lead        SimulationLead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([scope, createdAt])
  @@map("lead_suppressions")
}

model LeadScoreSnapshot {
  id               String         @id @default(cuid())
  leadId            String        @map("lead_id")
  productType       ProductType?  @map("product_type")
  scoreValue        Int           @map("score_value")
  normalizedScore   Int?          @map("normalized_score")
  eligibilityScore  Int?          @map("eligibility_score")
  propensityScore   Int?          @map("propensity_score")
  explanation       Json?
  createdAt         DateTime      @default(now()) @map("created_at")

  lead              SimulationLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([productType, createdAt])
  @@map("lead_score_snapshots")
}

model RevenueEvent {
  id             String         @id @default(cuid())
  leadId          String?       @map("lead_id")
  partnerId       String?       @map("partner_id")
  productType     ProductType?  @map("product_type")
  sourcePage      String?       @map("source_page")
  eventType       String        @map("event_type")
  estimatedCents  Int           @default(0) @map("estimated_cents")
  confirmedCents  Int           @default(0) @map("confirmed_cents")
  metadata        Json?
  occurredAt      DateTime      @default(now()) @map("occurred_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  lead            SimulationLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  adjustments     RevenueAdjustment[]

  @@index([leadId, occurredAt])
  @@index([partnerId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("revenue_events")
}

model PayoutEvent {
  id             String          @id @default(cuid())
  leadId          String?        @map("lead_id")
  partnerId       String?        @map("partner_id")
  payoutRuleId    String?        @map("payout_rule_id")
  amountCents     Int            @map("amount_cents")
  status          String         @default("estimated")
  metadata        Json?
  occurredAt      DateTime       @default(now()) @map("occurred_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  lead            SimulationLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  payoutRule      PartnerPayoutRule? @relation(fields: [payoutRuleId], references: [id], onDelete: SetNull)

  @@index([leadId, occurredAt])
  @@index([partnerId, occurredAt])
  @@index([status, occurredAt])
  @@map("payout_events")
}

model RevenueAdjustment {
  id             String        @id @default(cuid())
  revenueEventId String        @map("revenue_event_id")
  amountCents    Int           @map("amount_cents")
  reason         String
  createdAt      DateTime      @default(now()) @map("created_at")

  revenueEvent   RevenueEvent  @relation(fields: [revenueEventId], references: [id], onDelete: Cascade)

  @@index([revenueEventId, createdAt])
  @@map("revenue_adjustments")
}

model PartnerPayoutRule {
  id           String       @id @default(cuid())
  partnerId     String      @map("partner_id")
  productType   ProductType? @map("product_type")
  payoutType    String      @default("lead") @map("payout_type")
  amountCents   Int         @map("amount_cents")
  status        String      @default("active")
  metadata      Json?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  payoutEvents  PayoutEvent[]

  @@index([partnerId, status])
  @@index([productType, status])
  @@map("partner_payout_rules")
}

model IntegrationHealthCheck {
  id             String    @id @default(cuid())
  integrationKey String    @map("integration_key")
  status         String
  responseTimeMs Int?      @map("response_time_ms")
  details        Json?
  checkedAt      DateTime  @default(now()) @map("checked_at")

  @@index([integrationKey, checkedAt])
  @@index([status, checkedAt])
  @@map("integration_health_checks")
}

model PlatformAlert {
  id          String    @id @default(cuid())
  key         String
  severity    String
  status      String    @default("open")
  message     String
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@index([status, createdAt])
  @@index([severity, createdAt])
  @@map("platform_alerts")
}
