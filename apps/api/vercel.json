{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["node_modules/.prisma/client/**"]
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/articles/run",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/articles/run",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/cron/articles/run",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/articles/web-stories/run",
      "schedule": "45 22 * * *"
    },
    {
      "path": "/api/internal/distribution/backfill",
      "schedule": "45 2 * * *"
    },
    {
      "path": "/api/internal/seo/weekly-optimization",
      "schedule": "30 9 * * 1"
    },
    {
      "path": "/api/internal/seo/competitors/run",
      "schedule": "30 10 * * 3"
    },
    {
      "path": "/api/internal/articles/scale",
      "schedule": "10 8 * * *"
    },
    {
      "path": "/api/internal/reactivation/send-emails",
      "schedule": "30 12 * * 1-5"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
