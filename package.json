{
	"name": "monorepo",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "npm run dev --prefix apps/web",
		"dev:api": "npm run dev --prefix apps/api",
		"build": "npm run build --prefix apps/web",
		"check:encoding": "node tools/check-encoding.js",
		"start": "npm run start --prefix apps/web",
		"start:api": "npm run start --prefix apps/api",
		"postinstall": "npm run prisma:generate --prefix apps/api",
		"test:awin": "node scripts/testAwinApi.js",
		"test:awin:linkbuilder": "node scripts/testAwinLinkBuilder.js",
		"reactivation:tokens": "node scripts/reactivation/generateLeadTokens.js",
		"reactivation:batches": "node scripts/reactivation/segmentLeadBatches.js",
		"prisma:generate": "npm run prisma:generate --prefix apps/api",
		"prisma:migrate": "npm run prisma:migrate --prefix apps/api",
		"prisma:deploy": "npm run prisma:deploy --prefix apps/api",
		"lint": "npm run lint --prefix apps/web"
	},
	"dependencies": {
		"axios": "^1.11.0",
		"dotenv": "^16.6.1"
	},
	"workspaces": [
		"apps/*"
	]
}
